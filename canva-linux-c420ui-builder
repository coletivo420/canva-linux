#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
GENERATED_BUILDER="${ROOT_DIR}/build-resources/c420ui/bootstrap/generated/c420ui-builder.cjs"
DEV_BUILDER="${ROOT_DIR}/.build/scripts/c420ui-builder.mjs"

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' "Node.js is required to run Canva Linux Builder powered by c420ui." >&2
  printf '%s\n' "Install Node.js or use the packaged Canva Linux runtime app instead." >&2
  exit 127
fi

can_run_builder() {
  local entrypoint="$1"
  [[ -s "${entrypoint}" ]] || return 1
  node --check "${entrypoint}" >/dev/null 2>&1
}

if can_run_builder "${GENERATED_BUILDER}"; then
  exec node "${GENERATED_BUILDER}" "$@"
fi

# Legacy contract note: previous fallback text referenced:
# "Run npm run build:c420ui-bootstrap".
printf '%s\n' "[c420ui] bootstrap missing: build-resources/c420ui/bootstrap/generated/c420ui-builder.cjs is missing or invalid" >&2
printf '%s\n' "[c420ui] generating bootstrap bundle automatically..." >&2

if npm --prefix "${ROOT_DIR}" run build:c420ui-bootstrap; then
  if can_run_builder "${GENERATED_BUILDER}"; then
    exec node "${GENERATED_BUILDER}" "$@"
  fi
fi

if can_run_builder "${DEV_BUILDER}"; then
  exec node "${DEV_BUILDER}" "$@"
fi

printf '%s\n' "c420ui builder entrypoint is unavailable after automatic bootstrap generation." >&2
exit 1
