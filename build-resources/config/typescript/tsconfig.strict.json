{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force"
  },
  "include": [
    "../../electron/main/**/*.ts",
    "../../electron/shared/**/*.ts",
    "../../electron/preload/**/*.ts",
    "../../../build-resources/canva-linux/checks/core/**/*.ts",
    "../../canva-linux/**/*.ts"
  ]
}
