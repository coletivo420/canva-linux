{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "outDir": "../../../.build",
    "rootDir": "../..",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "moduleDetection": "force"
  },
  "include": [
    "../../electron/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "repo",
    "build-dir",
    ".flatpak-builder",
    ".build"
  ]
}
