{
  "name": "canva-linux",
  "version": "0.1.4-15.Dev.10",
  "description": "A community open-source desktop wrapper for use with Canva",
  "main": ".build/electron/main/index.js",
  "author": "Community",
  "license": "GPL-3.0-or-later",
  "productName": "Canva Linux",
  "homepage": "https://coletivo420.github.io/canva-linux/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coletivo420/canva-linux.git"
  },
  "bugs": {
    "url": "https://github.com/coletivo420/canva-linux/issues"
  },
  "scripts": {
    "start": "electron .",
    "dist": "NODE_OPTIONS=--no-deprecation electron-builder --linux dir",
    "dist:appimage": "npm run build:runtime && NODE_OPTIONS=--no-deprecation electron-builder --linux AppImage --publish=never",
    "lint": "eslint --config build-resources/config/eslint/eslint.config.ts .",
    "bootstrap:typescript": "esbuild build-resources/c420ui/scripts/run-typescript-script.ts --bundle --platform=node --target=node20 --format=cjs --external:esbuild --outfile=.build/scripts/bootstrap/run-typescript-script.js",
    "bootstrap:electron-builder": "esbuild build-resources/c420ui/scripts/electron-builder-before-build.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --external:esbuild --outfile=.build/scripts/bootstrap/electron-builder-before-build.js",
    "run:ts": "npm run bootstrap:typescript --silent && node .build/scripts/bootstrap/run-typescript-script.js",
    "build:scripts": "npm run build:metadata && esbuild build-resources/c420ui/scripts/build-runtime.ts build-resources/c420ui/scripts/build-preload-bundle.ts build-resources/c420ui/scripts/copy-runtime-assets.ts build-resources/c420ui/scripts/clean-runtime-build.ts build-resources/c420ui/scripts/run-node-tests.ts build-resources/canva-linux/scripts/doctor.ts build-resources/canva-linux/scripts/validate-project.ts build-resources/canva-linux/scripts/validate-flatpak.ts build-resources/canva-linux/scripts/validate-flathub-submission.ts build-resources/canva-linux/scripts/validate-appimage.ts build-resources/c420ui/scripts/install-native.ts build-resources/c420ui/scripts/install-flatpak.ts build-resources/c420ui/scripts/uninstall-native.ts build-resources/c420ui/scripts/uninstall-flatpak.ts build-resources/c420ui/scripts/uninstall-detected.ts build-resources/c420ui/scripts/reset-user-data.ts build-resources/c420ui/scripts/purge-installations.ts build-resources/c420ui/scripts/clean-artifacts.ts build-resources/c420ui/scripts/fix-build-permissions.ts build-resources/c420ui/scripts/show-detected-installations.ts build-resources/c420ui/scripts/show-version-info.ts build-resources/c420ui/scripts/build-appimage.ts build-resources/c420ui/scripts/build-flatpak-bundle.ts build-resources/c420ui/scripts/build-runtime-entry.ts build-resources/c420ui/scripts/build-electron-dir-entry.ts build-resources/c420ui/scripts/run-c420ui.ts build-resources/c420ui/scripts/run-c420ui-cli.ts build-resources/c420ui/scripts/c420ui-builder.ts build-resources/c420ui/bootstrap/build-recipe.ts build-resources/c420ui/bootstrap/source-hash.ts build-resources/c420ui/checks/check-bootstrap.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:blessed --external:esbuild --external:typescript --outdir=.build/scripts --entry-names=[name]",
    "test": "CANVA_SCRIPT_REPO_ROOT=$PWD npm run build:scripts && CANVA_SCRIPT_REPO_ROOT=$PWD node .build/scripts/run-node-tests.js",
    "test:unit": "npm run test -- build-resources/tests/window-open-policy.test.ts",
    "test:wiring": "npm run test -- build-resources/tests/tab-controller-wiring.test.ts",
    "test:smoke": "playwright test --config=build-resources/config/playwright/playwright.config.ts",
    "test:smoke:headed": "playwright test --config=build-resources/config/playwright/playwright.config.ts --headed",
    "lint:fix": "eslint --config build-resources/config/eslint/eslint.config.ts --fix .",
    "build:preload": "CANVA_SCRIPT_REPO_ROOT=$PWD npm run build:scripts && CANVA_SCRIPT_REPO_ROOT=$PWD node .build/scripts/build-preload-bundle.js",
    "clean:runtime": "CANVA_SCRIPT_REPO_ROOT=$PWD npm run build:scripts && CANVA_SCRIPT_REPO_ROOT=$PWD node .build/scripts/clean-runtime-build.js",
    "build:runtime": "CANVA_SCRIPT_REPO_ROOT=$PWD npm run build:scripts && CANVA_SCRIPT_REPO_ROOT=$PWD node .build/scripts/build-runtime.js",
    "build:check": "npm run build:scripts-core && node .build/build-resources/canva-linux/checks/core/check-runtime-build.js",
    "build": "npm run build:runtime",
    "prestart": "npm run build:runtime",
    "predist": "npm run build:runtime",
    "docs:check-links": "npm run build:scripts-core && node .build/build-resources/canva-linux/checks/core/check-doc-links.js",
    "deps:check-policy": "npm run build:scripts-core && node .build/build-resources/canva-linux/checks/core/check-dependency-policy.js",
    "typecheck": "tsc -p build-resources/config/typescript/tsconfig.json --noEmit",
    "validate:project": "npm run build:scripts && node .build/scripts/validate-project.js",
    "validate:doctor": "npm run build:scripts && node .build/scripts/doctor.js",
    "validate:flatpak": "npm run build:scripts && node .build/scripts/validate-flatpak.js",
    "validate:flathub-submission": "npm run build:scripts && node .build/scripts/validate-flathub-submission.js",
    "validate": "npm run check:scripts-core",
    "docs:check-ai": "npm run build:scripts-core && node .build/build-resources/canva-linux/checks/core/check-ai-guardrails.js",
    "typecheck:strict": "tsc -p build-resources/config/typescript/tsconfig.strict.json",
    "build:scripts-core": "rm -rf .build/build-resources/canva-linux/checks/core && esbuild build-resources/canva-linux/checks/core/check-ai-guardrails.ts build-resources/canva-linux/checks/core/check-doc-links.ts build-resources/canva-linux/checks/core/check-dependency-policy.ts build-resources/canva-linux/checks/core/check-runtime-build.ts build-resources/canva-linux/checks/core/check-repository-policy.ts --bundle --platform=node --format=cjs --outdir=.build/build-resources/canva-linux/checks/core",
    "check:scripts-core": "npm run check:c420ui-core && npm run check:canva-linux && npm run check:shared-tooling",
    "build:c420ui": "npm run build:c420ui-terminal",
    "c420ui": "CANVA_SCRIPT_REPO_ROOT=$PWD npm run build:scripts && CANVA_SCRIPT_REPO_ROOT=$PWD node .build/scripts/run-c420ui.js",
    "check:c420ui": "CANVA_SCRIPT_REPO_ROOT=$PWD npm run build:scripts && CANVA_SCRIPT_REPO_ROOT=$PWD node .build/scripts/run-c420ui.js --help",
    "build:c420ui-checks": "esbuild build-resources/c420ui/checks/check-*.ts --bundle --platform=node --format=cjs --outdir=.build/build-resources/c420ui/checks",
    "check:c420ui-core": "npm run build:c420ui-checks && node .build/build-resources/c420ui/checks/check-c420ui-core-contracts.js",
    "build:canva-linux-checks": "esbuild build-resources/canva-linux/checks/check-*.ts --bundle --platform=node --format=cjs --outdir=.build/build-resources/canva-linux/checks",
    "check:canva-linux": "npm run build:canva-linux-checks && npm run build:c420ui-checks && node .build/build-resources/canva-linux/checks/check-canva-linux-contracts.js && node .build/scripts/check-bootstrap.js",
    "check:shared-tooling": "npm run build:runtime && npm run build:scripts-core && node .build/build-resources/canva-linux/checks/core/check-ai-guardrails.js && node .build/build-resources/canva-linux/checks/core/check-doc-links.js && node .build/build-resources/canva-linux/checks/core/check-dependency-policy.js && node .build/build-resources/canva-linux/checks/core/check-runtime-build.js && node .build/build-resources/canva-linux/checks/core/check-repository-policy.js",
    "c420ui:cli": "CANVA_SCRIPT_REPO_ROOT=$PWD npm run build:scripts && CANVA_SCRIPT_REPO_ROOT=$PWD node .build/scripts/run-c420ui-cli.js",
    "build:c420ui-terminal": "esbuild build-resources/c420ui/src/terminal/index.ts --bundle --platform=node --format=cjs --external:blessed --outfile=.build/build-resources/c420ui/terminal/index.js",
    "build:c420ui-bootstrap": "npm run build:metadata && esbuild build-resources/c420ui/scripts/build-bootstrap.ts --bundle --platform=node --target=node22 --format=cjs --external:esbuild --outfile=.build/build-resources/c420ui/scripts/build-bootstrap.cjs && node .build/build-resources/c420ui/scripts/build-bootstrap.cjs",
    "check:c420ui-bootstrap": "npm run build:c420ui-checks && node .build/build-resources/c420ui/checks/check-bootstrap.js",
    "check:c420ui-bootstrap-artifacts": "npm run build:c420ui-checks && node .build/build-resources/c420ui/checks/check-artifact-gate.js",
    "build:metadata": "npm run run:ts -- build-resources/c420ui/scripts/generate-build-metadata.ts --committed",
    "build:metadata:effective": "npm run run:ts -- build-resources/c420ui/scripts/generate-build-metadata.ts --effective",
    "check:c420ui-node-check": "npm run build:c420ui-checks && node .build/build-resources/c420ui/checks/check-node.js",
    "test:c420ui": "npm run test -- build-resources/c420ui/test",
    "c420ui:install-native": "npm run build:scripts && node .build/scripts/install-native.js",
    "c420ui:build-appimage": "npm run build:scripts && node .build/scripts/build-appimage.js",
    "c420ui:build-flatpak-bundle": "npm run build:scripts && node .build/scripts/build-flatpak-bundle.js",
    "install:native": "npm run build:scripts && node .build/scripts/install-native.js",
    "install:flatpak": "npm run build:scripts && node .build/scripts/install-flatpak.js",
    "uninstall:native": "npm run build:scripts && node .build/scripts/uninstall-native.js",
    "uninstall:flatpak": "npm run build:scripts && node .build/scripts/uninstall-flatpak.js",
    "maintenance:purge": "npm run build:scripts && node .build/scripts/purge-installations.js",
    "maintenance:clean": "npm run build:scripts && node .build/scripts/clean-artifacts.js",
    "maintenance:fix-permissions": "npm run build:scripts && node .build/scripts/fix-build-permissions.js",
    "maintenance:show-detected": "npm run build:scripts && node .build/scripts/show-detected-installations.js",
    "maintenance:version-info": "npm run build:scripts && node .build/scripts/show-version-info.js",
    "package:appimage": "npm run build:scripts && node .build/scripts/build-appimage.js",
    "package:flatpak-bundle": "npm run build:scripts && node .build/scripts/build-flatpak-bundle.js"
  },
  "build": {
    "appId": "io.github.coletivo420.canva-linux",
    "productName": "Canva Linux",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources/canva-linux/assets"
    },
    "beforeBuild": "./.build/scripts/bootstrap/electron-builder-before-build.js",
    "files": [
      ".build/electron/**/*",
      "package.json"
    ],
    "linux": {
      "appId": "io.github.coletivo420.canva-linux",
      "target": "dir",
      "category": "Graphics",
      "executableName": "canva-linux",
      "icon": "icons/io.github.coletivo420.canva-linux"
    },
    "appImage": {
      "artifactName": "canva-linux-${version}-${arch}.AppImage"
    },
    "extraMetadata": {
      "main": ".build/electron/main/index.js"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "blessed": "^0.1.81"
  },
  "desktopName": "io.github.coletivo420.canva-linux.desktop",
  "engines": {
    "node": ">=22.0.0"
  }
}
